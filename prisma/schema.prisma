generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String          @id @default(cuid())
  email                String          @unique
  name                 String
  passwordHash         String
  role                 String          @default("MEMBER")
  sessions             Session[]
  member               MemberProfile?
  paymentsCreated      Payment[]       @relation("PaymentCreator")
  expensesCreated      Expense[]       @relation("ExpenseCreator")
  announcementsCreated Announcement[]  @relation("AnnouncementCreator")
  attendanceRecorded   Attendance[]    @relation("AttendanceRecorder")
  workoutPlansCreated  WorkoutPlan[]   @relation("WorkoutPlanCreator")
  progressRecorded     ProgressEntry[] @relation("ProgressRecorder")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model MemberProfile {
  id               String          @id @default(cuid())
  userId           String          @unique
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberCode       String?         @unique
  phone            String?
  membershipStatus String          @default("ACTIVE")
  planName         String          @default("Monthly")
  joinDate         DateTime        @default(now())
  expiryDate       DateTime
  nextDueDate      DateTime
  outstandingPaise Int             @default(0)
  memberships      Membership[]
  charges          Charge[]
  payments         Payment[]
  attendance       Attendance[]
  workoutPlans     WorkoutPlan[]
  progressEntries  ProgressEntry[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([membershipStatus])
  @@index([phone])
}

model MembershipPlan {
  id           String       @id @default(cuid())
  name         String       @unique
  durationDays Int
  feePaise     Int
  isActive     Boolean      @default(true)
  memberships  Membership[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Membership {
  id               String         @id @default(cuid())
  memberId         String
  member           MemberProfile  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId           String
  plan             MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  startDate        DateTime
  endDate          DateTime
  feePaiseSnapshot Int
  status           String         @default("ACTIVE")
  charge           Charge?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([memberId, endDate])
  @@index([planId])
}

model Charge {
  id           String        @id @default(cuid())
  memberId     String
  member       MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membershipId String?       @unique
  membership   Membership?   @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  amountPaise  Int
  dueDate      DateTime
  description  String
  createdAt    DateTime      @default(now())

  @@index([memberId, dueDate])
  @@index([dueDate])
}

model Payment {
  id            String        @id @default(cuid())
  memberId      String
  member        MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amountPaise   Int
  method        String
  receiptNumber String        @unique
  paidAt        DateTime
  note          String?
  createdById   String
  createdBy     User          @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now())

  @@index([memberId, paidAt])
  @@index([paidAt])
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  category    String
  amountPaise Int
  expenseDate DateTime
  note        String?
  createdById String
  createdBy   User     @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([expenseDate])
  @@index([category])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  isActive    Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdById String
  createdBy   User     @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, publishedAt])
}

model Attendance {
  id           String        @id @default(cuid())
  memberId     String
  member       MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  attendedAt   DateTime
  note         String?
  recordedById String
  recordedBy   User          @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())

  @@unique([memberId, attendedAt])
  @@index([memberId, attendedAt])
  @@index([attendedAt])
}

model WorkoutPlan {
  id          String            @id @default(cuid())
  memberId    String
  member      MemberProfile     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title       String
  notes       String?
  startsOn    DateTime
  isActive    Boolean           @default(true)
  createdById String
  createdBy   User              @relation("WorkoutPlanCreator", fields: [createdById], references: [id], onDelete: Restrict)
  exercises   WorkoutExercise[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([memberId, isActive])
  @@index([startsOn])
}

model WorkoutExercise {
  id              String      @id @default(cuid())
  workoutPlanId   String
  workoutPlan     WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  dayLabel        String
  exerciseName    String
  sets            Int?
  reps            String?
  durationMinutes Int?
  notes           String?
  sortOrder       Int         @default(0)
  createdAt       DateTime    @default(now())

  @@index([workoutPlanId, dayLabel, sortOrder])
}

model ProgressEntry {
  id             String        @id @default(cuid())
  memberId       String
  member         MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  recordedAt     DateTime
  weightGrams    Int?
  chestMm        Int?
  waistMm        Int?
  hipMm          Int?
  armMm          Int?
  thighMm        Int?
  note           String?
  recordedById   String
  recordedBy     User          @relation("ProgressRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())

  @@index([memberId, recordedAt])
  @@index([recordedAt])
}
